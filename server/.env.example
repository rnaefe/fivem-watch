# ─────────────────────────────────────────────
# fivem-watch-server — Environment Configuration
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────

# Port for the Express + Socket.io server
PORT=3001

# Secret key shared between FiveM resource and this backend
# Generate a strong random string (e.g. openssl rand -hex 32)
API_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET

# Dashboard admin credentials (used for web panel login)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME

# Allowed origins for CORS (comma separated, or * for all)
CORS_ORIGIN=http://localhost:5173
